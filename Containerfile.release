    chmod -R a=rX /srv

FROM docker.io/library/caddy@sha256:f43d8810c944e27e6f7ea80b165de11dbdab16cff15c8a80d83ae3e1a109a35d

LABEL org.opencontainers.image.source="https://github.com/dmedellin/learn-geterdone" \
      org.opencontainers.image.revision="__GIT_REVISION__" \
      org.opencontainers.image.title="Learn - geterdone.io"

COPY --chmod=0644 deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=site /srv /srv

ARG RELEASE_SHA=local
RUN printf '%s\n' "$RELEASE_SHA" > /srv/release.txt && chmod 0644 /srv/release.txt

# Fail the build on a malformed or unrendered config instead of shipping an
# image that crash-loops on the host.
RUN caddy validate --adapter caddyfile --config /etc/caddy/Caddyfile

# Drop the file capability the base image sets on the binary (cap_net_bind_service).
# The container runs unprivileged with cap_drop ALL + no-new-privileges and binds
# an unprivileged port only, so the capability is both useless and a liability.
RUN setcap -r /usr/bin/caddy

USER 1000:1000
EXPOSE 8080

# NOTE: `podman build` defaults to OCI image format, which DROPS HEALTHCHECK
# ("HEALTHCHECK is not supported for OCI image format and will be ignored").
# Build with `--format docker` if the image-level healthcheck is wanted. The
# authoritative liveness signal for the platform is the wrapper's health probe;
# this image-level check is also used by the host's generated Compose service.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD wget -q -O- http://127.0.0.1:8080/healthz || exit 1
