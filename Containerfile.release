# learn-geterdone — release image for https://learn.geterdone.io
#
# The site is hand-written static HTML. There is NO application build step, no
# bundler and no package manager here on purpose: inventing one would add supply
# chain and reproducibility risk for zero benefit. The first stage exists only to
# stage, verify and normalize the document root; the final stage is Caddy + files.
#
# RENDER-TIME PLACEHOLDERS (substitute before `podman build`):
#   __GIT_REVISION__   Exact 40-lowercase-hex protected-main commit being released.
#                      The deploy wrapper inspects this label and fails on mismatch.
# RELEASE_SHA is supplied as a build argument and written to /srv/release.txt.
# A build must fail, not proceed, if any __PLACEHOLDER__ survives rendering.

# Base image pinned by digest, mirroring the reference deployment.
# docker.io/library/caddy:2.10.0-alpine, digest recorded in the platform host
# baseline capture: platform-ops/artifacts/t_ba7cf663_base_images_detailed.txt
# and used by platform-ops/deployments/pixelbattle-landing/Containerfile.release.
# Re-verify against the registry (`skopeo inspect`) at release time; if it cannot
# be verified, replace it with __BASE_IMAGE_DIGEST__ and stop — never substitute
# a mutable tag and never write a plausible-looking digest.
FROM docker.io/library/caddy@sha256:f43d8810c944e27e6f7ea80b165de11dbdab16cff15c8a80d83ae3e1a109a35d AS site

WORKDIR /srv
COPY site/ ./

# Document-root contract. /srv IS the root of https://learn.geterdone.io:
#     /srv/index.html                            -> learn.geterdone.io/
#     /srv/paths/<subject>/index.html            -> learn.geterdone.io/paths/<subject>/
#     /srv/<course>/index.html                   -> learn.geterdone.io/<course>/
#     /srv/<course>/<lab>/index.html             -> learn.geterdone.io/<course>/<lab>/
# The site is a library of PATHS. /srv/paths/trading/index.html is the trading
# path page: it is NOT a course home and NOT a lesson, it is the ordered list of
# the eight courses that path holds — all eight are published and all eight are
# below. Nothing under /srv/paths/ is swept by the course loops: the first path
# segment "paths" belongs to that layer, and a course may never take it.
# There are eight courses: market-structure (seven lessons), trade-setup-execution
# (fifteen lessons), options-trading (sixteen lessons), technical-indicators
# (sixteen lessons), volume-and-order-flow (sixteen lessons),
# trading-risk-management (sixteen lessons), backtesting-and-trading-systems
# (sixteen lessons) and algorithmic-and-automated-trading (sixteen lessons), all
# listed in the RUN below, along with the eight published non-HTML assets. That
# is the same map as REQUIRED_PAGES plus NON_HTML_ASSETS in
# tests/test_site_invariants.py and acceptance.checks in release/contract.json
# — 853 pages and 8 assets. Each asset is tested on its own line: a guard that
# let a JSON file satisfy a page check would stop proving anything about either.
# The extra two pages and the eighth asset are the CAPSTONE: a dated, real-data
# worked example published under the path page at
# /srv/paths/trading/iren-analysis-2026-08-16/ (the interactive lab), its
# /slides/ deck, and the dataset both derive from. It is NOT a ninth course —
# the path is complete at eight — and it is not swept by any course loop; it is
# guarded on its own lines below, immediately after the path page it hangs off.
# It is also the only published material built from REAL market data, which is
# why its pages carry a real-data notice rather than the synthetic-examples
# disclaimer every course page carries (REAL_DATA_PAGES in
# tests/test_site_invariants.py declares that exception and enforces the
# stricter notice those two pages owe instead).
# The seven FLAT /<lesson>/ URLs this image used to publish are retired, and so
# is course 1's old /market-structure-lab/ prefix (that slug named the whole
# site, not the course): no stub is shipped for either and neither may be
# re-added here.
# The build fails loudly here rather than silently shipping an image whose URLs
# do not match the registered canonical host. If the repo tree ever nests the
# pages under an extra directory level, fix the tree (or this COPY) — do NOT
# paper over it with a rewrite in the Caddyfile.
# Also normalize modes: the image runs as UID 1000 with a read-only rootfs, so
# every published file must be world-readable and every directory traversable.
RUN set -eu; \
    test -f /srv/index.html || { echo "FATAL: missing /srv/index.html (the site index)"; exit 1; }; \
    test -f /srv/paths/trading/index.html || { echo "FATAL: missing /srv/paths/trading/index.html (the trading path page). It is published at learn.geterdone.io/paths/trading/ and is the only page that shows all eight courses of the path in one ordered list; the site index links to it, so its absence 404s the only route into the path."; exit 1; }; \
    test -f /srv/paths/trading/iren-analysis-2026-08-16/index.html || { echo "FATAL: missing /srv/paths/trading/iren-analysis-2026-08-16/index.html (the dated real-data capstone, interactive lab). It is published at learn.geterdone.io/paths/trading/iren-analysis-2026-08-16/ and the path page links to it; it is a worked example, not a ninth course."; exit 1; }; \
    test -f /srv/paths/trading/iren-analysis-2026-08-16/slides/index.html || { echo "FATAL: missing /srv/paths/trading/iren-analysis-2026-08-16/slides/index.html (the dated real-data capstone, slide deck)."; exit 1; }; \
    test -s /srv/paths/trading/iren-analysis-2026-08-16/iren-analysis-data.json || { echo "FATAL: missing or empty /srv/paths/trading/iren-analysis-2026-08-16/iren-analysis-data.json. It is a published URL: every price, bar, indicator and backtest figure on the two capstone pages derives from it, and it is published so the analysis can be checked rather than believed."; exit 1; }; \
    course=market-structure; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (course home of the Market Structure course)"; exit 1; }; \
    for lesson in market-structure \
            ranges-breakouts-liquidity \
            multi-timeframe-market-structure \
            pullbacks-entry-models \
            invalidation-stops-risk-reward \
            volume-relative-strength \
            options-contract-selection; do \
        test -f "/srv/$course/$lesson/index.html" || { echo "FATAL: missing /srv/$course/$lesson/index.html (lesson of the Market Structure course)"; exit 1; }; \
    done; \
    course=trade-setup-execution; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (course home of the Trade Setup and Execution course)"; exit 1; }; \
    for lesson in trade-thesis \
            support-resistance \
            confluence \
            breakout-setups \
            pullback-setups \
            reversal-setups \
            entry-confirmation \
            stop-loss-placement \
            profit-targets \
            risk-to-reward \
            position-sizing \
            trade-management \
            backtesting \
            trading-journal \
            performance-review; do \
        test -f "/srv/$course/$lesson/index.html" || { echo "FATAL: missing /srv/$course/$lesson/index.html (lesson of the Trade Setup and Execution course)"; exit 1; }; \
    done; \
    test -s "/srv/$course/trade-journal-schema.json" || { echo "FATAL: missing or empty /srv/$course/trade-journal-schema.json. It is a published URL: the course home links to it, lesson 14 exports that shape and lesson 15 imports it."; exit 1; }; \
    course=options-trading; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (course home of the Options Trading course)"; exit 1; }; \
    for lesson in options-contract-fundamentals \
            calls-and-puts \
            moneyness \
            option-premium \
            option-chain-and-liquidity \
            expiration-and-time-decay \
            implied-volatility \
            delta-and-gamma \
            theta-and-vega \
            long-calls-and-long-puts \
            covered-calls \
            cash-secured-puts \
            vertical-debit-spreads \
            vertical-credit-spreads \
            exercise-assignment-and-expiration \
            options-trade-planning; do \
        test -f "/srv/$course/$lesson/index.html" || { echo "FATAL: missing /srv/$course/$lesson/index.html (lesson of the Options Trading course)"; exit 1; }; \
    done; \
    test -s "/srv/$course/options-trade-plan-schema.json" || { echo "FATAL: missing or empty /srv/$course/options-trade-plan-schema.json. It is a published URL: the course home links to it and lesson 16 exports that shape."; exit 1; }; \
    course=technical-indicators; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (course home of the Technical Indicators course)"; exit 1; }; \
    for lesson in technical-indicator-fundamentals \
            moving-averages \
            moving-average-crossovers \
            relative-strength-index \
            stochastic-oscillator \
            macd \
            average-directional-index \
            average-true-range \
            bollinger-bands \
            keltner-channels \
            donchian-channels \
            rate-of-change-and-momentum \
            indicator-divergence \
            combining-indicators \
            indicator-selection-by-market-regime \
            indicator-based-trading-rules; do \
        test -f "/srv/$course/$lesson/index.html" || { echo "FATAL: missing /srv/$course/$lesson/index.html (lesson of the Technical Indicators course)"; exit 1; }; \
    done; \
    test -s "/srv/$course/indicator-rule-schema.json" || { echo "FATAL: missing or empty /srv/$course/indicator-rule-schema.json. It is a published URL: the course home links to it and lesson 16 exports that shape."; exit 1; }; \
    course=volume-and-order-flow; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (course home of the Volume and Order Flow course)"; exit 1; }; \
    for lesson in volume-fundamentals \
            price-volume-relationships \
            relative-volume-and-volume-spikes \
            volume-confirmation \
            on-balance-volume \
            accumulation-distribution-and-chaikin-money-flow \
            volume-weighted-average-price \
            anchored-volume-weighted-average-price \
            volume-profile \
            value-area-poc-hvn-lvn \
            bid-ask-spread-and-order-types \
            time-and-sales \
            footprint-charts-and-bid-ask-delta \
            cumulative-volume-delta \
            order-book-and-market-depth \
            volume-and-order-flow-trading-rules; do \
        test -f "/srv/$course/$lesson/index.html" || { echo "FATAL: missing /srv/$course/$lesson/index.html (lesson of the Volume and Order Flow course)"; exit 1; }; \
    done; \
    test -s "/srv/$course/volume-order-flow-rule-schema.json" || { echo "FATAL: missing or empty /srv/$course/volume-order-flow-rule-schema.json. It is a published URL: the course home links to it and lesson 16 exports that shape."; exit 1; }; \
    course=trading-risk-management; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (course home of the Trading Risk Management course)"; exit 1; }; \
    for lesson in risk-management-fundamentals \
            account-risk-and-risk-budget \
            risk-per-trade \
            stop-loss-and-structural-invalidation \
            position-sizing \
            reward-to-risk-and-r-multiples \
            win-rate-average-win-loss-and-expectancy \
            losing-streaks-and-drawdown \
            risk-of-ruin \
            volatility-and-atr-based-risk \
            gap-slippage-liquidity-and-execution-risk \
            leverage-and-margin-risk \
            correlation-concentration-and-portfolio-exposure \
            options-risk-management \
            daily-and-weekly-risk-limits \
            trading-risk-plan; do \
        test -f "/srv/$course/$lesson/index.html" || { echo "FATAL: missing /srv/$course/$lesson/index.html (lesson of the Trading Risk Management course)"; exit 1; }; \
    done; \
    test -s "/srv/$course/trading-risk-plan-schema.json" || { echo "FATAL: missing or empty /srv/$course/trading-risk-plan-schema.json. It is a published URL: the course home links to it and lesson 16 exports that shape."; exit 1; }; \
    course=backtesting-and-trading-systems; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (course home of the Backtesting and Trading Systems course)"; exit 1; }; \
    for lesson in backtesting-fundamentals \
            testable-trading-rules-and-hypotheses \
            historical-data-and-data-quality \
            survivorship-selection-and-corporate-actions \
            timeframes-sessions-and-bar-construction \
            signal-timing-look-ahead-bias-and-data-leakage \
            trade-execution-simulation \
            position-sizing-and-portfolio-accounting \
            transaction-costs-spread-slippage-and-liquidity \
            trade-log-equity-curve-and-drawdown \
            performance-metrics-and-expectancy \
            benchmarking-and-risk-adjusted-performance \
            in-sample-validation-and-out-of-sample-data \
            walk-forward-testing \
            overfitting-sensitivity-monte-carlo-and-stress-testing \
            trading-system-specification-and-backtest-report; do \
        test -f "/srv/$course/$lesson/index.html" || { echo "FATAL: missing /srv/$course/$lesson/index.html (lesson of the Backtesting and Trading Systems course)"; exit 1; }; \
    done; \
    test -s "/srv/$course/trading-system-specification-schema.json" || { echo "FATAL: missing or empty /srv/$course/trading-system-specification-schema.json. It is a published URL: the course home links to it and lesson 16 exports that shape."; exit 1; }; \
    course=algorithmic-and-automated-trading; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (course home of the Algorithmic and Automated Trading course)"; exit 1; }; \
    for lesson in algorithmic-and-automated-trading-fundamentals \
            trading-system-architecture-and-components \
            market-data-ingestion-and-normalization \
            time-sessions-events-and-scheduling \
            signal-engine-and-strategy-state \
            portfolio-position-and-risk-engine \
            broker-apis-and-order-lifecycle \
            order-management-and-execution \
            paper-trading-and-forward-testing \
            scanners-alerts-and-human-approval \
            reliability-idempotency-retries-and-recovery \
            observability-logging-and-auditability \
            security-secrets-permissions-and-kill-switches \
            deployment-environments-and-configuration \
            ai-assisted-and-agentic-trading-workflows \
            automated-trading-system-specification-and-production-readiness; do \
        test -f "/srv/$course/$lesson/index.html" || { echo "FATAL: missing /srv/$course/$lesson/index.html (lesson of the Algorithmic and Automated Trading course)"; exit 1; }; \
    done; \
    test -s "/srv/$course/automated-trading-system-schema.json" || { echo "FATAL: missing or empty /srv/$course/automated-trading-system-schema.json. It is a published URL: the course home links to it and lesson 16 exports that shape."; exit 1; }; \
    test -f /srv/paths/discrete-math/index.html || { echo "FATAL: missing /srv/paths/discrete-math/index.html (the discrete mathematics path page). It is published at learn.geterdone.io/paths/discrete-math/ and is the only page showing all eight courses of that path in one ordered list; the site index links to it, so its absence 404s the only route into the path."; exit 1; }; \
    course=logic-and-proof; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (discrete mathematics course 1 home)."; exit 1; }; \
    for lesson in propositions-and-truth-values \
            logical-connectives \
            truth-tables \
            conditional-statements \
            logical-equivalence \
            tautologies-and-satisfiability \
            normal-forms-and-boolean-algebra \
            predicates-and-quantifiers \
            nested-quantifiers \
            negating-quantified-statements \
            rules-of-inference \
            direct-proof \
            contraposition-and-contradiction \
            proof-by-cases-and-counterexample; do \
        test -f "/srv/$course/$lesson/index.html" || { echo "FATAL: missing /srv/$course/$lesson/index.html"; exit 1; }; \
    done; \
    course=sets-relations-functions; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (discrete mathematics course 2 home)."; exit 1; }; \
    for lesson in sets-and-membership \
            subsets-and-power-sets \
            set-operations \
            set-identities \
            cartesian-products-and-tuples \
            binary-relations \
            properties-of-relations \
            equivalence-relations-and-partitions \
            partial-orders \
            functions \
            injective-surjective-bijective \
            composition-and-inverses \
            cardinality-and-countability \
            the-pigeonhole-principle; do \
        test -f "/srv/$course/$lesson/index.html" || { echo "FATAL: missing /srv/$course/$lesson/index.html"; exit 1; }; \
    done; \
    course=induction-and-recursion; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (discrete mathematics course 3 home)."; exit 1; }; \
    for lesson in the-well-ordering-principle \
            mathematical-induction \
            induction-with-sums-and-products \
            induction-with-inequalities-and-divisibility \
            strong-induction \
            recursive-definitions \
            structural-induction \
            recursive-algorithms \
            recurrence-relations \
            solving-linear-recurrences \
            divide-and-conquer-recurrences \
            loop-invariants-and-correctness; do \
        test -f "/srv/$course/$lesson/index.html" || { echo "FATAL: missing /srv/$course/$lesson/index.html"; exit 1; }; \
    done; \
    course=combinatorics-and-counting; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (discrete mathematics course 4 home)."; exit 1; }; \
    for lesson in sum-and-product-rules \
            counting-with-restrictions \
            permutations \
            combinations \
            binomial-coefficients \
            the-binomial-theorem \
            permutations-with-repetition \
            combinations-with-repetition \
            inclusion-exclusion \
            derangements \
            generalized-pigeonhole \
            generating-functions \
            combinatorial-proof \
            choosing-a-counting-method; do \
        test -f "/srv/$course/$lesson/index.html" || { echo "FATAL: missing /srv/$course/$lesson/index.html"; exit 1; }; \
    done; \
    course=discrete-probability; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (discrete mathematics course 5 home)."; exit 1; }; \
    for lesson in sample-spaces-and-events \
            computing-probabilities \
            probability-axioms \
            conditional-probability \
            independence \
            bayes-theorem \
            random-variables \
            expected-value \
            linearity-of-expectation \
            variance \
            binomial-distribution \
            geometric-distribution; do \
        test -f "/srv/$course/$lesson/index.html" || { echo "FATAL: missing /srv/$course/$lesson/index.html"; exit 1; }; \
    done; \
    course=number-theory-and-cryptography; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (discrete mathematics course 6 home)."; exit 1; }; \
