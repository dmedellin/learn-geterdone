    done; \
    test -f /srv/paths/algebra/index.html || { echo "FATAL: missing /srv/paths/algebra/index.html (the algebra path page). It is published at learn.geterdone.io/paths/algebra/ and is the only page showing all nine courses of that path in one ordered list; the site index links to it, so its absence 404s the only route into the path."; exit 1; }; \
    course=algebra-foundations; \
    test -f "/srv/$course/index.html" || { echo "FATAL: missing /srv/$course/index.html (algebra course 1 home)."; exit 1; }; \
