            point-slope-and-standard-form \
            parallel-and-perpendicular-lines \
            what-a-function-is \
            function-notation \
            domain-and-range \
            piecewise-functions \
            transformations-of-graphs \
            composition-of-functions \
            inverse-functions \
            linear-inequalities-in-two-variables; do \
