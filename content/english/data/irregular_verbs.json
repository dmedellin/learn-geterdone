  "classes": {
    "all_same": {
      "rule": "base, past and participle are the identical string (put/put/put).",
      "count": 21
    },
    "base_eq_past": {
      "rule": "base and past are the identical string but the participle differs (beat/beat/beaten).",
      "count": 1
    },
    "base_eq_pp": {
      "rule": "base and participle are the identical string but the past differs (come/came/come).",
      "count": 4
    },
    "past_eq_pp": {
      "rule": "past and participle are the identical string and both differ from the base (bring/brought/brought).",
      "count": 60
    },
    "all_diff_n": {
      "rule": "base, past and participle are three different strings, and the participle ends in the letter n (know/knew/known).",
      "count": 37
    },
    "all_diff_other": {
      "rule": "base, past and participle are three different strings, and the participle does NOT end in n (sing/sang/sung).",
      "count": 9
    },
    "no_class_handcoded": {
      "rule": "not a string rule: 'be' has a suppletive present (am/is/are) and two past forms (was/were), so it is excluded from the base/past/pp classifier by hand rather than forced into one of the six classes.",
      "count": 1
    }
  }
}
